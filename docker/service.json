{
  "_comment": "The kernel's own compose fragment. Merged with every package fragment by scripts/compose.mjs. JSON so the generator needs no YAML dependency; the output is real YAML.",
  "services": {
    "kernel": {
      "build": { "context": "..", "dockerfile": "docker/Dockerfile" },
      "environment": {
        "DATABASE_URL": "postgres://ghost:ghost@db:5432/ghost",
        "PORT": "3000"
      },
      "depends_on": ["db"],
      "ports": ["3000:3000"]
    },
    "db": {
      "image": "postgres:17-alpine",
      "environment": {
        "POSTGRES_USER": "ghost",
        "POSTGRES_PASSWORD": "ghost",
        "POSTGRES_DB": "ghost"
      },
      "volumes": ["ghost-db:/var/lib/postgresql/data"]
    }
  },
  "volumes": { "ghost-db": null }
}
